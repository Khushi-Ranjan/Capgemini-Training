<?xml version="1.0" encoding="UTF-8"?>

<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="
       http://www.springframework.org/schema/beans
       http://www.springframework.org/schema/beans/spring-beans.xsd">

    <bean id="kit" class= "map_dependency_injection.Kit">

        <!-- Constructor arg for name -->
        <constructor-arg value="Emergency Kit"/>

        <!-- Constructor arg for Map -->
        <constructor-arg>
            <map>
                <entry key="Bandage" value="5"/>
                <entry key="Torch" value="1"/>
                <entry key="WaterBottle" value="2"/>
                <entry key="FirstAid" value="1"/>
            </map>
        </constructor-arg>

    </bean>

</beans>